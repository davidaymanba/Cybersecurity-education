# Production .env for docker-compose.prod.yml — copy to .env on the server and fill the blanks.
# Secrets marked <generate> are created by deploy/setup.sh; never commit the real file.

APP_NAME="CyberLearn AI"
APP_ENV=production
APP_KEY=<generate>
APP_DEBUG=false
APP_URL=https://cyber.codexai.systems
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Caddy (rasd-caddy-1) on the shared proxy network sets X-Forwarded-For to the real client.
# Trusting that network keeps per-IP login throttling per student instead of global.
PROXY_NETWORK=rasd_default
TRUSTED_PROXIES=172.18.0.0/16

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cyberlearn
DB_USERNAME=cyberlearn
DB_PASSWORD=<generate>
MYSQL_ROOT_PASSWORD=<generate>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Password-reset e-mails are only written to the log until real SMTP is configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@codexai.systems"
MAIL_FROM_NAME="${APP_NAME}"

# AI provider (fill in on the server).
GROQ_API_KEY=
GROQ_SINGLE_API_KEY=
GROQ_MULTI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

# Demo accounts created by `php artisan db:seed` (fill in before seeding).
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
